{
  "name": "pi-web-rescue",
  "version": "0.0.1",
  "description": "Web route probe + deterministic URL/RSS/HTML fetch fallback for Pi",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "web",
    "fetch",
    "rss",
    "html",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-web-rescue.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-web-rescue/issues"
  },
  "homepage": "https://github.com/eiei114/pi-web-rescue#readme",
  "bin": {
    "pi-web-rescue": "bin/web-rescue-doctor.js",
    "web-rescue-doctor": "bin/web-rescue-doctor.js"
  },
  "files": [
    "bin/",
    "extensions/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run check",
    "pack:check": "npm pack --dry-run",
    "build": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "commands": {
      "web-rescue:doctor": "./bin/web-rescue-doctor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.0.0",
    "typebox": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
